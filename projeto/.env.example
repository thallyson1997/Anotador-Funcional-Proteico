# Configurações - Copie para .env.local e ajuste conforme necessário

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_LOG_LEVEL=info

# Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=8080
API_BASE_URL=http://localhost:8000

# InterProScan (serão usadas quando integrar com API real)
INTERPRO_API_URL=https://www.ebi.ac.uk/Tools/services/rest/iprscan5
INTERPRO_EMAIL=seu.email@exemplo.com
INTERPRO_TIMEOUT=600

# Database (opcional - para futuro)
DATABASE_URL=postgresql://user:password@localhost/anotador_db

# Ambiente
ENV=development
DEBUG=true
